#!/bin/sh

# Resolve the directory containing this launcher to an absolute path.
BASEDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

JAVA_BIN="$BASEDIR/jre/bin/java"
ICON="$BASEDIR/../Resources/appico.png"

JAVA_FLAGS="
-XX:+UseZGC
-XX:+TieredCompilation
-XX:MaxMetaspaceSize=128m
-Dsun.rmi.transport.tcp.maxConnectionThreads=0
-XX:-DontCompileHugeMethods
-XX:+DisableAttachMechanism
-Xms512m
-Xmx1024m
--add-opens=java.base/java.util=ALL-UNNAMED
--enable-native-access=ALL-UNNAMED
"

# Verify the bundled Java runtime.
if [ ! -x "$JAVA_BIN" ]; then
  echo "Bundled Java runtime not found or not executable:" >&2
  echo "  $JAVA_BIN" >&2
  exit 1
fi

# Find the application JAR.
JAR=""

for candidate in "$BASEDIR"/zxpoly-emul*.jar; do
  if [ -f "$candidate" ]; then
    JAR="$candidate"
    break
  fi
done

if [ -z "$JAR" ]; then
  echo "ZXPolyEmul JAR not found in:" >&2
  echo "  $BASEDIR" >&2
  exit 1
fi

# Start the application.
exec "$JAVA_BIN" $JAVA_FLAGS \
  -Xdock:icon="$ICON" \
  -jar "$JAR" "$@"
